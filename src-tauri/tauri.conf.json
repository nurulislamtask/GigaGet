{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GigaGet",
  "version": "0.1.0",
  "identifier": "app.gigaget.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GigaGet",
        "width": 1000,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Paste a link, get the file.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
